{
  "name": "dsh-session-ultra",
  "version": "0.8.0",
  "description": "Fork of dsh-session-manager for DeepSeek Harness — per-feature toggles, native sidebar ⋯ menu integration, no title-bar takeover. | dsh-session-manager 精简分支：功能可逐项开关、集成进原生侧边栏菜单、默认不占标题栏。",
  "license": "MIT",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "deepseek-harness-plugin",
    "plugin",
    "session",
    "session-manager",
    "session-management",
    "archive",
    "move",
    "workspace",
    "workspace-archive",
    "workspace-management",
    "preset",
    "agent-preset",
    "migration",
    "cordis"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/meowmeowloong/dsh-session-ultra.git"
  },
  "bugs": {
    "url": "https://github.com/meowmeowloong/dsh-session-ultra/issues"
  },
  "homepage": "https://github.com/meowmeowloong/dsh-session-ultra",
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "LICENSE",
    "README.md",
    "README.zh.md",
    "CHANGELOG.md",
    "scripts/heal-v2-sessions.ps1"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots"
      ],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.0-rc <5"
  },
  "engines": {
    "node": "^22.15.0 || >=24.0.0"
  },
  "scripts": {
    "check": "node --check lib/index.js && node --check lib/client.js && node --check lib/session-files.js && node --check lib/annotation-store.js && node --check lib/workspace-archive-store.js && node --check lib/clipboard-parser.js && node -e \"import('./lib/index.js')\"",
    "test": "node scripts/run-tests.mjs",
    "check:package": "node scripts/check-package.mjs"
  }
}
